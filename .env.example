# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace USERNAME, PASSWORD, and CLUSTER with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/utilityBilling?retryWrites=true&w=majority

# Session Secret (Generate a strong random string in production)
SESSION_SECRET=your_long_random_session_secret_here
