<%- include('./partials/header') %>

<div class="auth-wrapper">
  <div class="auth-card" style="text-align: center; max-width: 500px;">
    <div style="font-size: 3rem; margin-bottom: 12px;">
      <%= statusCode === 403 ? '🚫' : (statusCode === 404 ? '🔍' : '⚠️') %>
    </div>

    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--gray-900); margin-bottom: 8px;">
      <%= statusCode || 500 %> - <%= title || 'Error' %>
    </h1>

    <p style="color: var(--gray-600); margin-bottom: 24px; font-size: 0.95rem;">
      <%= message || 'An unexpected error occurred.' %>
    </p>

    <div style="display: flex; gap: 12px; justify-content: center;">
      <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
      <a href="/" class="btn btn-primary">Return to Portal</a>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
